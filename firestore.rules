rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function own(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function admin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function approved(uid) {
      return get(/databases/$(database)/documents/members/$(uid)).data.status == 'approved';
    }
    function identity(field) {
      return request.auth.token.get(field, '');
    }
    match /admins/{uid} {
      allow get: if own(uid);
    }
    match /members/{uid} {
      allow get: if own(uid) || admin();
      allow list: if admin();
      allow create: if own(uid)
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'phone']
        && request.resource.data.keys().hasOnly(['email', 'phone', 'status', 'createdAt'])
        && request.resource.data.email == identity('email')
        && request.resource.data.phone == identity('phone_number')
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if admin() && !exists(/databases/$(database)/documents/admins/$(uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['approved', 'rejected', 'suspended']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid;
      match /apps/{appId} {
        allow read: if own(uid) && (admin() || approved(uid));
        allow create, update: if own(uid) && (admin() || approved(uid))
          && request.resource.data.id == appId
          && request.resource.data.keys().hasOnly(['id', 'name', 'description', 'url', 'imageUrl', 'repository', 'author', 'origin', 'category', 'status', 'favorite', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 300
          && request.resource.data.description is string && request.resource.data.description.size() <= 20000
          && request.resource.data.url is string && request.resource.data.url.size() <= 4000
          && request.resource.data.get('imageUrl', '') is string && request.resource.data.get('imageUrl', '').size() <= 4000
          && request.resource.data.repository is string && request.resource.data.repository.size() <= 4000
          && request.resource.data.author is string && request.resource.data.author.size() <= 300
          && request.resource.data.origin in ['mine', 'external']
          && request.resource.data.category is string && request.resource.data.category.size() <= 100
          && request.resource.data.status in ['active', 'archived']
          && request.resource.data.favorite is bool
          && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
      }
    }
  }
}
